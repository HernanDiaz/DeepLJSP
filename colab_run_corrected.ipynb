            # Ejecutar el comando específico
            !python -m jobshop_rl.main --mode single --episodes 300 --reward adaptive --visualize --save-plots --train-problem ft10 --eval-problem abz10 --use-ortools
        except ImportError as e:
            print(f"Error al importar jobshop_rl: {e}")
            print("Intentando una ejecución alternativa...")

            # Intento alternativo si la estructura del módulo es diferente
            !python main.py --mode single --episodes 300 --reward adaptive --visualize --save-plots --train-problem ft10 --eval-problem abz10
    else:
        print("ERROR: No se encontró el módulo jobshop_rl. Verifica la estructura del repositorio.")

# @title Visualizar resultados
# @markdown Ejecuta esta celda para visualizar los resultados

if IN_COLAB:
    import matplotlib.pyplot as plt
    import matplotlib.image as mpimg
    import glob
    import os

    # Buscar en múltiples ubicaciones posibles
    possible_output_dirs = ['outputs', '.', 'results', 'output']
    found_images = False

    for output_dir in possible_output_dirs:
        if not os.path.exists(output_dir):
            continue

        # Buscar imágenes en el directorio principal
        image_files = glob.glob(f'{output_dir}/*.png')

        if image_files:
            found_images = True
            print(f"Mostrando {len(image_files)} imágenes encontradas en {output_dir}/:")

            for img_file in image_files:
                try:
                    img = mpimg.imread(img_file)
                    plt.figure(figsize=(12, 8))
                    plt.imshow(img)
                    plt.axis('off')
                    plt.title(os.path.basename(img_file))
                    plt.show()
                except Exception as e:
                    print(f"No se pudo mostrar {img_file}: {e}")

        # Buscar también en subdirectorios
        for subdir in glob.glob(f'{output_dir}/*/'):
            image_files = glob.glob(f'{subdir}/*.png')
            if image_files:
                found_images = True
                print(f"\nMostrando {len(image_files)} imágenes en {subdir}:")

                for img_file in image_files:
                    try:
                        img = mpimg.imread(img_file)
                        plt.figure(figsize=(12, 8))
                        plt.imshow(img)
                        plt.axis('off')
                        plt.title(os.path.basename(img_file))
                        plt.show()
                    except Exception as e:
                        print(f"No se pudo mostrar {img_file}: {e}")

    if not found_images:
        print("No se encontraron imágenes en ninguna de las ubicaciones esperadas.")
        print("Listando directorios y archivos disponibles:")
        !find . -name "*.png" -type f


